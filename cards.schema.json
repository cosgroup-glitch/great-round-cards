{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Great Round Card Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "effects",
          "modifiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "kind"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "kind": {
                  "enum": [
                    "bonus",
                    "new",
                    "drawback"
                  ]
                }
              }
            }
          },
          "modifiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stat",
                "operation",
                "value"
              ],
              "properties": {
                "stat": {
                  "enum": [
                    "MaxHealth",
                    "MoveSpeed",
                    "JumpImpulse",
                    "Damage",
                    "FireRate",
                    "ReloadTime",
                    "Ammo",
                    "BulletSpeed",
                    "BulletLifetime",
                    "BulletBounces",
                    "BulletSize",
                    "Spread",
                    "Recoil",
                    "BlockCooldown",
                    "BlockDuration",
                    "BodySize",
                    "ProjectileCount",
                    "RemoteControl",
                    "DrillDistance",
                    "BuckshotStacks",
                    "BounceSpeedMultiplier",
                    "ReloadOnDamage",
                    "TerrainAvoidance",
                    "BulletGravityMultiplier",
                    "ProjectileSimulationSpeed",
                    "BulletSizeAdd",
                    "BurstCount",
                    "BurstInterval",
                    "BounceDamageMultiplier",
                    "GrowDamage",
                    "Homing",
                    "TargetBounce",
                    "LifeSteal",
                    "RefreshBlockOnDamage",
                    "ReloadOnBlock",
                    "BlockOnEmpty",
                    "DisablePassiveReload",
                    "EchoBlocks",
                    "BulletSlow",
                    "DamageOverTime",
                    "FrostSlam",
                    "HealingField",
                    "Implode",
                    "Shockwave",
                    "Overpower",
                    "Silence",
                    "StaticField",
                    "Supernova",
                    "SawField",
                    "TeleportDistance",
                    "ChillingPresence",
                    "LifeDrainAura",
                    "Chase",
                    "TasteOfBlood",
                    "Brawler"
                  ]
                },
                "operation": {
                  "enum": [
                    "Add",
                    "Multiply",
                    "Override",
                    "ClampMin",
                    "ClampMax"
                  ]
                },
                "value": {
                  "type": "number"
                }
              }
            }
          },
          "icon": {
            "enum": [
              "MaxHealth",
              "MoveSpeed",
              "JumpImpulse",
              "Damage",
              "FireRate",
              "ReloadTime",
              "Ammo",
              "BulletSpeed",
              "BulletLifetime",
              "BulletBounces",
              "BulletSize",
              "Spread",
              "Recoil",
              "BlockCooldown",
              "BlockDuration",
              "BodySize",
              "ProjectileCount",
              "RemoteControl",
              "DrillDistance",
              "BuckshotStacks",
              "BounceSpeedMultiplier",
              "ReloadOnDamage",
              "TerrainAvoidance",
              "BulletGravityMultiplier",
              "ProjectileSimulationSpeed",
              "BulletSizeAdd",
              "BurstCount",
              "BurstInterval",
              "BounceDamageMultiplier",
              "GrowDamage",
              "Homing",
              "TargetBounce",
              "LifeSteal",
              "RefreshBlockOnDamage",
              "ReloadOnBlock",
              "BlockOnEmpty",
              "DisablePassiveReload",
              "EchoBlocks",
              "BulletSlow",
              "DamageOverTime",
              "FrostSlam",
              "HealingField",
              "Implode",
              "Shockwave",
              "Overpower",
              "Silence",
              "StaticField",
              "Supernova",
              "SawField",
              "TeleportDistance",
              "ChillingPresence",
              "LifeDrainAura",
              "Chase",
              "TasteOfBlood",
              "Brawler"
            ]
          },
          "minimums": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "MaxHealth",
                "MoveSpeed",
                "JumpImpulse",
                "Damage",
                "FireRate",
                "ReloadTime",
                "Ammo",
                "BulletSpeed",
                "BulletLifetime",
                "BulletBounces",
                "BulletSize",
                "Spread",
                "Recoil",
                "BlockCooldown",
                "BlockDuration",
                "BodySize",
                "ProjectileCount",
                "RemoteControl",
                "DrillDistance",
                "BuckshotStacks",
                "BounceSpeedMultiplier",
                "ReloadOnDamage",
                "TerrainAvoidance",
                "BulletGravityMultiplier",
                "ProjectileSimulationSpeed",
                "BulletSizeAdd",
                "BurstCount",
                "BurstInterval",
                "BounceDamageMultiplier",
                "GrowDamage",
                "Homing",
                "TargetBounce",
                "LifeSteal",
                "RefreshBlockOnDamage",
                "ReloadOnBlock",
                "BlockOnEmpty",
                "DisablePassiveReload",
                "EchoBlocks",
                "BulletSlow",
                "DamageOverTime",
                "FrostSlam",
                "HealingField",
                "Implode",
                "Shockwave",
                "Overpower",
                "Silence",
                "StaticField",
                "Supernova",
                "SawField",
                "TeleportDistance",
                "ChillingPresence",
                "LifeDrainAura",
                "Chase",
                "TasteOfBlood",
                "Brawler"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "setId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "alpha"
          }
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 240
          },
          "enabledByDefault": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
